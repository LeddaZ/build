From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leonardo Ledda <leonardoledda@gmail.com>
Date: Wed, 25 Nov 2026 12:00:00 +0100
Subject: [PATCH] hwmon: pwm-fan: add fan-initial-percent

The driver starts the fan at full speed at probe. On handhelds, a
userspace service sets the speed later, and the fan is loud until then.

Add the optional property fan-initial-percent. It sets the speed and the
cooling state at probe.

---
diff --git a/Documentation/devicetree/bindings/hwmon/pwm-fan.yaml b/Documentation/devicetree/bindings/hwmon/pwm-fan.yaml
index a84cc3a..de050af 100644
--- a/Documentation/devicetree/bindings/hwmon/pwm-fan.yaml
+++ b/Documentation/devicetree/bindings/hwmon/pwm-fan.yaml
@@ -46,6 +46,13 @@ properties:
     minimum: 0
     maximum: 100
 
+  fan-initial-percent:
+    description:
+      Fan speed in percent at probe. If absent, the fan starts at the
+      highest cooling level, or at full speed.
+    minimum: 0
+    maximum: 100
+
   fan-stop-to-start-us:
     description:
       Time to wait in microseconds after start when stopped.
diff --git a/drivers/hwmon/pwm-fan.c b/drivers/hwmon/pwm-fan.c
index 9bdbe63..2bfbc01 100644
--- a/drivers/hwmon/pwm-fan.c
+++ b/drivers/hwmon/pwm-fan.c
@@ -509,7 +509,8 @@ static int pwm_fan_probe(struct platform_device *pdev)
 	struct device *hwmon;
 	int ret;
 	const struct hwmon_channel_info **channels;
-	u32 initial_pwm, pwm_min_from_stopped = 0;
+	u32 initial_pwm, initial_percent, pwm_min_from_stopped = 0;
+	unsigned long initial_state;
 	u32 pwm_shutdown_percent = 0;
 	u32 *fan_channel_config;
 	int channel_count = 1;	/* We always have a PWM channel. */
@@ -567,9 +568,21 @@ static int pwm_fan_probe(struct platform_device *pdev)
 		initial_pwm = ctx->pwm_fan_cooling_levels[ctx->pwm_fan_max_state];
 	else
 		initial_pwm = MAX_PWM;
+	initial_state = ctx->pwm_fan_max_state;
+
+	/* Optional start speed. Userspace or a thermal zone sets the speed later. */
+	if (!device_property_read_u32(dev, "fan-initial-percent", &initial_percent)) {
+		initial_pwm = DIV_ROUND_CLOSEST(min(initial_percent, 100U) * MAX_PWM, 100);
+		/* Highest cooling state at or below the start speed */
+		initial_state = 0;
+		while (ctx->pwm_fan_cooling_levels &&
+		       initial_state < ctx->pwm_fan_max_state &&
+		       ctx->pwm_fan_cooling_levels[initial_state + 1] <= initial_pwm)
+			initial_state++;
+	}
 
 	/*
-	 * Set duty cycle to maximum allowed and enable PWM output as well as
+	 * Set the start duty cycle and enable PWM output as well as
 	 * the regulator. In case of error nothing is changed
 	 */
 	ret = set_pwm(ctx, initial_pwm);
@@ -577,6 +590,17 @@ static int pwm_fan_probe(struct platform_device *pdev)
 		dev_err(dev, "Failed to configure PWM: %d\n", ret);
 		return ret;
 	}
+
+	/* set_pwm(0) does nothing on a fan that is off. Stop a PWM output left on by the bootloader. */
+	if (!initial_pwm) {
+		ctx->pwm_state.enabled = false;
+		ctx->pwm_state.duty_cycle = 0;
+		ret = pwm_apply_might_sleep(ctx->pwm, &ctx->pwm_state);
+		if (ret) {
+			dev_err(dev, "Failed to stop PWM: %d\n", ret);
+			return ret;
+		}
+	}
 	timer_setup(&ctx->rpm_timer, sample_timer, 0);
 	ret = devm_add_action_or_reset(dev, pwm_fan_cleanup, ctx);
 	if (ret)
@@ -693,7 +717,7 @@ static int pwm_fan_probe(struct platform_device *pdev)
 		return PTR_ERR(hwmon);
 	}
 
-	ctx->pwm_fan_state = ctx->pwm_fan_max_state;
+	ctx->pwm_fan_state = initial_state;
 	if (IS_ENABLED(CONFIG_THERMAL)) {
 		cdev = devm_thermal_of_cooling_device_register(dev,
 			dev->of_node, "pwm-fan", ctx, &pwm_fan_cooling_ops);
