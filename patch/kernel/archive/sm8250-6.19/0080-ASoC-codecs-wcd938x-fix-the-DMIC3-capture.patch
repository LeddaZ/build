From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leonardo Ledda <leonardoledda@gmail.com>
Date: Wed, 25 Nov 2026 12:30:00 +0100
Subject: [PATCH] ASoC: codecs: wcd938x: fix the DMIC3 capture

DMIC3 records only zeros. The codec sends DMIC3 data only when the
left channel of DMIC data line 2 is enabled (DMIC2_CTL bit 7). The
downstream driver sets this bit.

Also, WCD938X_AMIC1_IN_SEL_AMIC is 0, the same value as the DMIC
select. After a DMIC use, the input stays on DMIC. Use 1, as the
register default (0x0F) and the downstream driver do.

---
diff --git a/sound/soc/codecs/wcd938x.c b/sound/soc/codecs/wcd938x.c
index e1a4783..ec45b1c 100644
--- a/sound/soc/codecs/wcd938x.c
+++ b/sound/soc/codecs/wcd938x.c
@@ -1063,6 +1063,11 @@ static int wcd938x_codec_enable_dmic(struct snd_soc_dapm_widget *w,
 				WCD938X_AMIC1_IN_SEL_DMIC);
 		/* 250us sleep as per HW requirement */
 		usleep_range(250, 260);
+		/* DMIC3 is the left channel of DMIC data line 2 */
+		if (w->shift == 2)
+			snd_soc_component_write_field(component,
+						      WCD938X_DIGITAL_CDC_DMIC2_CTL,
+						      WCD938X_DMIC3_LEFT_EN_MASK, 1);
 		/* Setting DMIC clock rate to 2.4MHz */
 		snd_soc_component_write_field(component, dmic_clk_reg,
 					      dmic_clk_mask,
@@ -1077,6 +1082,10 @@ static int wcd938x_codec_enable_dmic(struct snd_soc_dapm_widget *w,
 		snd_soc_component_write_field(component,
 				WCD938X_DIGITAL_CDC_AMIC_CTL,
 				dmic_sel_mask, WCD938X_AMIC1_IN_SEL_AMIC);
+		if (w->shift == 2)
+			snd_soc_component_write_field(component,
+						      WCD938X_DIGITAL_CDC_DMIC2_CTL,
+						      WCD938X_DMIC3_LEFT_EN_MASK, 0);
 		snd_soc_component_write_field(component, dmic_clk_en_reg,
 					      WCD938X_DMIC_CLK_EN_MASK, 0);
 		break;
diff --git a/sound/soc/codecs/wcd938x.h b/sound/soc/codecs/wcd938x.h
index c186104..77438a7 100644
--- a/sound/soc/codecs/wcd938x.h
+++ b/sound/soc/codecs/wcd938x.h
@@ -446,7 +446,7 @@
 #define WCD938X_DIGITAL_CDC_RST                 (0x3458)
 #define WCD938X_DIGITAL_CDC_AMIC_CTL            (0x345A)
 #define WCD938X_AMIC1_IN_SEL_DMIC		0
-#define WCD938X_AMIC1_IN_SEL_AMIC		0
+#define WCD938X_AMIC1_IN_SEL_AMIC		1
 #define WCD938X_AMIC1_IN_SEL_MASK		BIT(0)
 #define WCD938X_AMIC3_IN_SEL_MASK		BIT(1)
 #define WCD938X_AMIC4_IN_SEL_MASK		BIT(2)
@@ -456,6 +456,7 @@
 #define WCD938X_DIGITAL_CDC_DMIC1_CTL           (0x345C)
 #define WCD938X_DMIC_CLK_EN_MASK		BIT(3)
 #define WCD938X_DIGITAL_CDC_DMIC2_CTL           (0x345D)
+#define WCD938X_DMIC3_LEFT_EN_MASK		BIT(7)
 #define WCD938X_DIGITAL_CDC_DMIC3_CTL           (0x345E)
 #define WCD938X_DIGITAL_CDC_DMIC4_CTL           (0x345F)
 #define WCD938X_DIGITAL_EFUSE_PRG_CTL           (0x3460)
